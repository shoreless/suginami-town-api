  "spots": [
   {
    "id": "ogikubo-hachiman",
    "category": "shrine",
    "name": {
     "en": "Ogikubo Hachiman Shrine",
     "ja": "荻窪八幡神社"
    },
    "about": {
     "en": "The guardian shrine of old Kami-Ogikubo village, founded by tradition in the 890s. Ōta Dōkan is said to have prayed here in 1477 and planted an umbrella pine, the Dōkan-maki, which is now the sacred tree and a ward natural monument. The shrine also keeps a great banner written by Katsu Kaishū.",
     "ja": "旧上荻窪村の鎮守で、寛平年間（889〜898年）の創建と伝わる。1477年に太田道灌が戦勝を祈って植えたとされるコウヤマキ「道灌槇」は御神木で、区の天然記念物。勝海舟の筆による大幟も伝わる。"
    },
    "location": [
     35.710621,
     139.606329
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "杉並区公式ホームページ",
     "url": "https://www.city.suginami.tokyo.jp/s113/7458.html"
    },
    "kami": [
     "hachiman"
    ]
   },
   {
    "id": "ogikubo-hakusan",
    "category": "shrine",
    "name": {
     "en": "Ogikubo Hakusan Shrine",
     "ja": "荻窪白山神社"
    },
    "about": {
     "en": "The guardian shrine of old Shimo-Ogikubo village, said to date from the 1470s or 80s. It is known as a shrine for toothache: legend says the kami told a sufferer in a dream to eat with chopsticks cut from the bush clover in the grounds, and the pain went away.",
     "ja": "旧下荻窪村の鎮守で、文明年間の創建と伝わる。境内の萩で作った箸で食事をせよという夢のお告げで歯の痛みが消えたという伝説から、歯痛にご利益がある神社として知られる。"
    },
    "location": [
     35.705496,
     139.61605
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "杉並区公式ホームページ",
     "url": "https://www.city.suginami.tokyo.jp/s113/7455.html"
    },
    "kami": [
     "izanami"
    ]
   },
   {
    "id": "minami-ogikubo-tenso",
    "category": "shrine",
    "name": {
     "en": "Minami-Ogikubo Tenso Shrine",
     "ja": "南荻窪天祖神社"
    },
    "about": {
     "en": "A shrine already stood here at a land survey in 1584. In the Edo period it was called Shinmei-sha, which gave the neighborhood its old name, Shinmei, and to its east there was once a riding ground lined with cherry trees.",
     "ja": "1584年の検地の時点ですでに社があったとされる古社。江戸時代は神明社と呼ばれ、地名「神明」の由来となった。東側にはかつて桜並木の馬場があった。"
    },
    "location": [
     35.7005,
     139.609556
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "杉並区公式ホームページ",
     "url": "https://www.city.suginami.tokyo.jp/s113/7544.html"
    },
    "kami": [
     "amaterasu"
    ]
   },
   {
    "id": "tabata-shrine",
    "category": "shrine",
    "name": {
     "en": "Tabata Shrine",
     "ja": "田端神社"
    },
    "about": {
     "en": "The guardian shrine of old Tabata village, once a Tenjin shrine called Kitano Jinja; its name means 'at the edge of the rice fields'. Ōkuninushi, enshrined here, is prayed to for leg and back pain, and the wooden mallets offered in thanks are a registered ward folk cultural property.",
     "ja": "旧田端村の鎮守で、かつては北野神社と呼ばれた天神社。社名は「田の端」にあったことに由来する。大国主命は足腰の痛みにご利益があるとされ、お礼に奉納された木槌は区の登録民俗文化財。"
    },
    "location": [
     35.693975,
     139.626204
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "杉並区公式ホームページ",
     "url": "https://www.city.suginami.tokyo.jp/s113/7447.html"
    },
    "kami": [
     "sugawara-no-michizane",
     "okuninushi"
    ]
   },
   {
    "id": "harukiya",
    "category": "eat",
    "name": {
     "en": "Harukiya",
     "ja": "中華そば 春木屋"
    },
    "about": {
     "en": "Open since 1949 and one of the places that made 'Ogikubo ramen' famous: clear soy-sauce chūka soba topped with a triangle of nori. Its motto is to keep changing so that the taste can stay the same.",
     "ja": "1949年創業。「荻窪ラーメン」の名を広めた一軒で、澄んだ醤油の中華そばに三角の海苔がのる。「変わらぬ美味しさの為に変わり続ける」がモットー。"
    },
    "location": [
     35.705109,
     139.622437
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2014/10/harukiya.html"
    }
   },
   {
    "id": "juhachiban",
    "category": "eat",
    "name": {
     "en": "Juhachiban",
     "ja": "手もみラーメン 十八番"
    },
    "about": {
     "en": "A hand-kneaded ramen counter since 1966 that opens in the evening and stays open past midnight. The garlicky tokusei juhachiban comes in soy or miso.",
     "ja": "1966年創業、夕方に開いて深夜まで営業する手もみラーメンの店。ニンニクの効いた「特製十八番」は醤油と味噌から選べる。"
    },
    "location": [
     35.704838,
     139.622406
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2014/10/juhachiban.html"
    }
   },
   {
    "id": "honmura-an",
    "category": "eat",
    "name": {
     "en": "Honmura-an",
     "ja": "本むら庵"
    },
    "about": {
     "en": "A soba house founded in 1924. Each day's buckwheat is ground in a stone mill, and the noodles are bound with well water.",
     "ja": "1924年創業のそば店。その日に打つ分だけ玄そばを石臼で挽き、井戸水でつなぐ江戸前の二八そば。"
    },
    "location": [
     35.704506,
     139.611786
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2014/10/honmuraan.html"
    }
   },
   {
    "id": "kameya-ogikubo",
    "category": "shop",
    "name": {
     "en": "Kameya",
     "ja": "御菓子司 亀屋"
    },
    "about": {
     "en": "A wagashi shop that moved here from Yotsuya in 1930, after the Great Kantō Earthquake. Its best-known sweet is the café-au-lait daifuku: coffee-flavored bean paste and cream, sold frozen.",
     "ja": "関東大震災の後、1930年に四谷から荻窪へ移った和菓子の老舗。名物はコーヒー風味のこしあんと生クリームを包んだ冷凍の「カフェオレ大福」。"
    },
    "location": [
     35.707138,
     139.616364
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2014/10/kameya.html"
    }
   },
   {
    "id": "mignon",
    "category": "drink",
    "name": {
     "en": "Meikyoku Kissa Mignon",
     "ja": "名曲喫茶ミニヨン"
    },
    "about": {
     "en": "A classical music café opened in 1961, south of the station since 1971. LPs play on a fine sound system, with concerts and exhibitions in the room behind.",
     "ja": "1961年に開店し、1971年から駅南口のこの場所で営業する名曲喫茶。LPレコードをよい音で聴かせ、奥の部屋ではコンサートや展示も開く。"
    },
    "location": [
     35.703632,
     139.622543
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
