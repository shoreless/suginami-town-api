    }
   },
   {
    "id": "seiko-lodging",
    "category": "culture",
    "name": {
     "en": "Seikō Lodging",
     "ja": "西郊ロッヂング"
    },
    "about": {
     "en": "A boarding house that moved here from Hongō in 1931, with Western-style rooms that locked, rare at the time. The 1931 main building and 1938 annex are registered tangible cultural properties. It is now an inn and apartments, so admire it from the street.",
     "ja": "1931年に本郷から移ってきた下宿で、当時珍しい鍵付きの洋室を備えていた。本館（1931年）と新館（1938年）は国の登録有形文化財。今は旅館と賃貸住宅なので、外から眺めたい。"
    },
    "location": [
     35.702972,
     139.625565
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2016/11/seiko-lodging.html"
    }
   },
   {
    "id": "gengi-sanbo",
