    }
   },
   {
    "id": "eitaro-asagaya",
    "category": "shop",
    "name": {
     "en": "Eitarō",
     "ja": "御菓子司 栄太楼"
    },
    "about": {
     "en": "A wagashi shop on the Pearl Center arcade since 1958, now in its third generation, known for kuri-shigure, steamed bean paste with chestnut.",
     "ja": "1958年、阿佐谷パールセンターに開いた和菓子店で、現在は三代目。餡を蒸かしてふっくら仕上げた栗しぐれで知られる。"
    },
    "location": [
