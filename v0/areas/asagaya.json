    }
   },
   {
    "id": "toraya-chinzan",
    "category": "shop",
    "name": {
     "en": "Toraya Chinzan",
     "ja": "とらや椿山"
    },
    "about": {
     "en": "A wagashi shop on the Pearl Center arcade since 1925. Its big chestnut manjū, a whole candied chestnut in white bean paste, came out of a craftsmen's contest in the early 1960s.",
     "ja": "1925年創業、パールセンターの和菓子店。蜜漬けの大粒栗を丸ごと白餡で包んだ名物「大栗まん」は、昭和30年代後半に職人のコンクールから生まれた。"
    },
    "location": [
     35.701286,
     139.637009
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2014/10/toraya-chinzan.html"
    }
   },
   {
    "id": "kamaju",
    "category": "shop",
    "name": {
     "en": "Kamajū",
     "ja": "蒲重蒲鉾店"
    },
    "about": {
     "en": "A fish-cake maker since 1936. The family fries about thirty kinds of satsuma-age from five in the morning, and sells oden all year.",
     "ja": "1936年創業のかまぼこ店。朝5時から約30種類のさつま揚げを揚げたてで並べ、おでんは一年中。"
    },
    "location": [
     35.70369,
     139.636993
    ],
    "checked": "2026-09-25",
    "source": {
