  "spots": [
   {
    "id": "eifuku-inari",
    "category": "shrine",
    "name": {
     "en": "Eifuku Inari Shrine",
     "ja": "永福稲荷神社"
    },
    "about": {
     "en": "Founded in 1530 as guardian of the neighboring temple Eifukuji, with a spirit from Fushimi Inari in Kyoto, and today the guardian shrine of all Eifuku. Its hall was rebuilt in 1878 facing west, to watch over the whole town.",
     "ja": "1530年、隣の永福寺の守護として京都の伏見稲荷から勧請された。現在は永福全域の氏神。1878年の再建の際、町全体を見守るよう西向きに建てられた。"
    },
    "location": [
     35.672444,
     139.64325
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "東京都神社庁",
     "url": "http://www.tokyo-jinjacho.or.jp/suginami/5965"
    },
    "kami": [
     "ukanomitama"
    ]
   },
   {
    "id": "eifuku-aoyagi",
    "category": "shop",
    "name": {
     "en": "Eifuku Aoyagi",
     "ja": "永福 青柳"
    },
    "about": {
     "en": "A wagashi shop by Eifukuchō station since 1934, making fresh daifuku and dango from five each morning. Its baked sweet 'Eifuku' once won a Prime Minister's award.",
     "ja": "1934年創業、永福町駅前の和菓子店。毎朝5時過ぎから大福やだんごを作る。焼き菓子「永福」は内閣総理大臣賞を受けたことがある。"
    },
    "location": [
     35.676727,
     139.64296
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2017/09/eifukuaoyagi.html"
    }
   },
   {
    "id": "bourbon",
    "category": "shop",
    "name": {
     "en": "Bourbon",
     "ja": "フランス菓子 ブルボン"
    },
    "about": {
     "en": "A white-tiled neighborhood cake shop beside the tracks at Nishi-Eifuku since 1969, known for its orange cake.",
     "ja": "1969年開店、西永福駅の線路脇に建つ白いタイルの洋菓子店。オレンジケーキが名物。"
    },
