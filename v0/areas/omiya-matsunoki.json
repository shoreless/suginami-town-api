  "spots": [
   {
    "id": "omiya-hachimangu",
    "category": "shrine",
    "name": {
     "en": "Ōmiya Hachimangū",
     "ja": "大宮八幡宮"
    },
    "about": {
     "en": "Founded by tradition in 1063. On his way to war, Minamoto no Yoriyoshi saw eight bands of white cloud here like Genji banners, and after his victory he brought a spirit from Iwashimizu Hachimangū in Kyoto to found the shrine.",
     "ja": "1063年の創建と伝わる。戦いに向かう途中、この地で源氏の白旗のような八条の白雲を見た源頼義が、凱旋後に京都の石清水八幡宮から勧請した。"
    },
    "location": [
     35.682375,
     139.639664
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "大宮八幡宮",
     "url": "https://www.ohmiya-hachimangu.or.jp/hachimangu/history"
    },
    "kami": [
     "hachiman",
     "chuai",
     "jingu"
    ]
   },
   {
    "id": "omiya-tenmangu",
    "category": "shrine",
    "name": {
     "en": "Ōmiya Tenmangū",
     "ja": "大宮天満宮"
    },
    "about": {
     "en": "A shrine to Sugawara no Michizane, patron of learning, within the grounds of Ōmiya Hachimangū. Students come here to pray for exam success.",
     "ja": "大宮八幡宮の境内にある、学問の神・菅原道真公をまつる社。受験生が合格祈願に訪れる。"
    },
    "location": [
     35.682639,
     139.639573
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "大宮八幡宮",
     "url": "https://www.ohmiya-hachimangu.or.jp/hachimangu"
    },
    "kami": [
     "sugawara-no-michizane"
    ]
   },
   {
    "id": "history-museum",
    "category": "culture",
    "name": {
     "en": "Suginami Local History Museum",
     "ja": "杉並区立郷土博物館"
    },
    "about": {
     "en": "The ward's history museum, opened in 1989 near the Zenpukuji River; you go in through a thatched gatehouse. The land belonged to the Saga family, and in 1937 their daughter Hiro left from here to marry Pujie, brother of the last emperor of China.",
     "ja": "1989年開館の区立郷土博物館で、茅葺きの長屋門が入口。敷地はかつて嵯峨侯爵家のもので、1937年、嵯峨浩はここから愛新覚羅溥傑との結婚式へ向かった。"
    },
    "location": [
     35.685661,
     139.644547
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2018/02/suginami-historical-museum.html"
    }
   },
   {
    "id": "takachiho-budojo",
    "category": "culture",
    "name": {
     "en": "Takachiho Budōjō",
     "ja": "高千穂学園武道場"
    },
    "about": {
     "en": "Built in 1913 as the judo and kendo hall of Takachiho College, it's the oldest wooden school building in the ward and a ward cultural property. The original 36 springs and 10 large jars are still under the floor.",
     "ja": "1913年、高千穂高等商業学校の柔剣道場として建てられた区内最古の木造学校建築で、区指定有形文化財。床下には創建当時の36本のバネと10個の大甕が残る。"
    },
    "location": [
     35.682804,
     139.638245
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2016/07/takachiho-budojo.html"
    }
   }
