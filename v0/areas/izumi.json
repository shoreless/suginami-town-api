   {
    "id": "izumi-kumano",
    "category": "shrine",
    "name": {
     "en": "Izumi Kumano Shrine",
     "ja": "和泉熊野神社"
    },
    "about": {
     "en": "The guardian shrine of old Izumi village, founded by tradition in 1267 with a spirit from the Kumano shrines of Kii. The present hall dates from 1863, and Jōmon and Kofun-period pottery has been dug up in the grounds.",
     "ja": "旧和泉村の鎮守で、1267年に紀州熊野から勧請したと伝わる。現在の社殿は1863年の建築。境内からは縄文・古墳時代の土器が出土している。"
    },
    "location": [
     35.676423,
     139.647758
    ],
    "checked": "2026-09-23",
    "source": {
