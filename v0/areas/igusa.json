    }
   },
   {
    "id": "icho-inari",
    "category": "shrine",
    "name": {
     "en": "Ichō Inari Shrine",
     "ja": "銀杏稲荷神社"
    },
    "about": {
     "en": "The guardian shrine of old Shimo-Igusa village, named after a great ginkgo that once grew on the hill behind it. A ridge plate dates its founding to around 1616, by the Iguchi family who settled here.",
     "ja": "旧下井草村の鎮守。かつて裏の丘にそびえた大銀杏が名の由来。棟札によれば、1616年ごろ、この地に住んだ井口家が創建した。"
    },
    "location": [
     35.718796,
     139.626633
    ],
    "checked": "2026-09-23",
    "source": {
