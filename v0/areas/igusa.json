  "spots": [
   {
    "id": "otori-shrine",
    "category": "shrine",
    "name": {
     "en": "Ōtori Shrine (Shimo-Igusa)",
     "ja": "大鷲神社（下井草）"
    },
    "about": {
     "en": "Its sacred object is a stuffed eagle, with a wingspan of over two metres, that villagers caught in a red pine in January 1921 and enshrined so that its death would bring no curse. A Tori-no-ichi fair is held on November's Days of the Rooster, with kumade rakes sold for good business.",
     "ja": "御神体は、1921年1月に村人が赤松で捕らえた、翼を広げると2mを超える大鷲の剥製。祟りのないようにとまつられた。11月の酉の日には酉の市が開かれ、商売繁盛の熊手が売られる。"
    },
    "location": [
     35.716049,
     139.628876
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "杉並区公式ホームページ",
