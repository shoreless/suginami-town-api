   {
    "id": "harunaya",
    "category": "shop",
    "name": {
     "en": "Harunaya",
     "ja": "和菓子 榛名屋"
    },
    "about": {
     "en": "A family wagashi shop on Kyōkai-dōri since 1977, named after Mount Haruna in the founder's Gunma. The mame daifuku is made from nothing but rice, beans, sugar and salt.",
     "ja": "1977年から教会通りで営む家族の和菓子店。店名は創業者の故郷・群馬の榛名山から。豆大福は米、小豆、砂糖、塩だけで作る。"
    },
