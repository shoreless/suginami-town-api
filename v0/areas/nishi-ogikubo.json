    }
   },
   {
    "id": "amaikko",
    "category": "eat",
    "name": {
     "en": "Amaikko",
     "ja": "甘味処 甘いっ子"
    },
    "about": {
     "en": "A sweets parlor open since 1965, known for kakigōri with homemade strawberry and apricot syrups. A regular of more than twenty years took it over in 2000.",
     "ja": "1965年開店の甘味処。自家製のいちごや杏のシロップをかけるかき氷が名物。20年以上通った常連が2000年に店を継いだ。"
    },
    "location": [
