  "spots": [
   {
    "id": "shoan-inari",
    "category": "shrine",
    "name": {
     "en": "Nishi-Takaido Shōan Inari Shrine",
     "ja": "西高井戸松庵稲荷神社"
    },
    "about": {
     "en": "The guardian shrine of old Shōan village, which by tradition a doctor named Shōan opened in the 1650s. Two stone towers at the entrance, dated 1690 and 1693, show the village was there by then.",
     "ja": "旧松庵村の鎮守。村は万治年間、松庵という医師が開いたと伝わる。入口に立つ1690年と1693年の石塔が、そのころすでに村があったことを物語る。"
    },
    "location": [
     35.699667,
     139.595917
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "杉並区公式ホームページ",
     "url": "https://www.city.suginami.tokyo.jp/s113/7502.html"
    },
    "kami": [
     "ukemochi"
    ]
   },
   {
    "id": "fushimi-inari",
    "category": "shrine",
    "name": {
     "en": "Fushimi Inari Shrine (Nishi-Ogikubo)",
     "ja": "伏見稲荷神社（西荻窪）"
    },
    "about": {
     "en": "Founded in 1951 by the shopkeepers of this street, who brought a spirit from Kyoto's Fushimi Inari to pray for good trade; Nishi-Ogi Fushimi-dori is named after it. The pin marks the red torii on the street: the small shrine is about 30m down the alley behind it.",
     "ja": "1951年、通りの商店主たちが商売繁盛を願って京都の伏見稲荷から勧請した。西荻伏見通りの名はこの神社に由来する。地図のピンは通りの赤い鳥居で、社は路地を30mほど入った奥にある。"
    },
    "location": [
     35.704259,
     139.598915
    ],
    "checked": "2026-09-23",
    "source": {
     "name": "西荻伏見通り商店会",
     "url": "https://nishiogi-fushimidori.com/history"
    }
   },
   {
    "id": "monozuki",
    "category": "drink",
    "name": {
     "en": "Monozuki",
     "ja": "物豆奇"
    },
    "about": {
     "en": "A coffee house opened around 1975 and filled with antiques the first owner gathered from all over Japan: wall clocks, oil lamps, pillars from old farmhouses. The second owner has kept it just as it was.",
     "ja": "1975年ごろ開店の喫茶店。初代が全国から集めた古時計や石油ランプ、古民家の柱が店を飾り、二代目はそのままの姿を守っている。"
    },
    "location": [
     35.705437,
     139.596985
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2014/10/monozuki.html"
    }
   },
   {
    "id": "kokeshiya",
    "category": "eat",
    "name": {
     "en": "Kokeshiya",
     "ja": "こけし屋"
    },
    "about": {
     "en": "Opened by the station in 1949 as a coffee shop, then added Western cakes and French cooking; the painter Suzuki Shintarō designed its wrapping paper. It closed in 2022 to rebuild and reopened in May 2026.",
     "ja": "1949年に駅前で喫茶店として開店し、洋菓子、そしてフランス料理へと広げてきた。包装紙は画家・鈴木信太郎のデザイン。建て替えのため2022年に休業し、2026年5月に再開した。"
    },
    "location": [
     35.703484,
     139.600494
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2014/10/kokeshiya.html"
    }
   },
   {
    "id": "miharado",
    "category": "shop",
    "name": {
     "en": "Miharadō",
     "ja": "三原堂"
    },
    "about": {
     "en": "A wagashi shop opened in 1935 under a name shared by Miharadō of Yotsuya. Known for thin, crisp shio senbei with the rice grains left in.",
     "ja": "1935年、四谷三原堂からのれん分けで開店した和菓子店。米粒を残して薄く焼いたパリパリの「塩せんべい」が名物。"
    },
    "location": [
     35.704487,
     139.600586
    ],
    "checked": "2026-09-25",
    "source": {
     "name": "すぎなみ学倶楽部",
     "url": "https://www.suginamigaku.org/2014/10/miharado.html"
    }
   },
   {
    "id": "kidaya",
    "category": "shop",
    "name": {
     "en": "Kidaya",
     "ja": "喜田屋"
    },
    "about": {
     "en": "A wagashi shop opened in 1948, famous for mame daifuku packed with red peas under a thin skin. In winter they can sell out before noon.",
     "ja": "1948年創業の和菓子店。薄い皮に豆がぎっしりの豆大福が有名で、冬は昼前に売り切れることも。"
    },
    "location": [
