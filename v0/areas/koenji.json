    }
   },
   {
    "id": "nanatsumori",
    "category": "drink",
    "name": {
     "en": "Nanatsumori",
     "ja": "七つ森"
    },
    "about": {
     "en": "A coffee house since 1978, made from the last unit of an old row of shops, keeping its beams and pillars and filled with antiques.",
     "ja": "1978年開業の喫茶店。長屋の商店の一棟を、梁や柱を生かして改装し、アンティークの調度で飾った。"
    },
    "location": [
