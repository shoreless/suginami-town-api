    "name": {
     "en": "Ōishi Shoten",
     "ja": "大石書店"
    },
    "about": {
     "en": "A secondhand bookshop opened in 1931, when Kōenji was still a village road with a few shops, and run by the same family ever since.",
     "ja": "1931年、まだ店がまばらだった高円寺に開いた古書店。以来、家族で営業を続けている。"
    },
